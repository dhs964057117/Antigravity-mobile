# Antigravity Phone Connect Configuration

# Your password for the mobile interface (required when accessing remotely)
APP_PASSWORD=your-app-password

# Tunnel Provider (cloudflare, ngrok, or pinggy)
# cloudflare: Free, supports temporary quick tunnel and persistent Zero Trust token
# ngrok: Requires free account and NGROK_AUTHTOKEN
# pinggy: Free SSH-based tunnel, no install needed (pip install pinggy)
TUNNEL_PROVIDER=cloudflare

# ==============================================================================
# 🌐 Persistent Custom Domain Configuration (Cloudflare Zero Trust - Recommended)
# ==============================================================================
# If left blank, an ephemeral random tunnel (*.trycloudflare.com) is used.
# To keep a permanent, fixed custom domain that never changes:
# 1. Sign up/log in at Cloudflare Zero Trust (https://one.dash.cloudflare.com)
# 2. Go to Networks -> Tunnels -> "Create a tunnel" -> Select "Cloudflared"
# 3. Copy the tunnel token provided in the dashboard and paste here:
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
#
# 4. In Cloudflare dashboard, add a Public Hostname (e.g. agent.yourdomain.com -> localhost:3000)
# 5. Set your fixed custom domain here (used for QR code and link generation):
# CUSTOM_DOMAIN=https://agent.yourdomain.com

# [Alternative] Local Named Tunnel with credentials file:
# CLOUDFLARE_TUNNEL_NAME=your-tunnel-name
# CLOUDFLARE_TUNNEL_URL=https://agent.yourdomain.com

# [Alternative] ngrok Reserved Domain:
# NGROK_AUTHTOKEN=your-ngrok-authtoken
# NGROK_DOMAIN=your-subdomain.ngrok-free.app

# Pinggy Access Token (Optional - for persistent subdomain)
# PINGGY_TOKEN=your-pinggy-token

# ==============================================================================
# 🛡️ Sleep Prevention & Active Keep-Alive Watchdog
# ==============================================================================
# Prevents Windows from going into system sleep or powering off network adapters
# while the server is running (default: true).
PREVENT_SLEEP=true

# Server Port
PORT=3000

# Security (Optional - Change to invalidate all current sessions)
# SESSION_SECRET=your-random-session-secret-here
# AUTH_SALT=your-random-auth-salt-here
